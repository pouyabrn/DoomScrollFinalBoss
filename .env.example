# Copy this file to .env for local development. Never commit .env.
FINALBOSS_DATABASE_URL=sqlite:///./.state/finalboss.db
FINALBOSS_OPENROUTER_API_KEY=
FINALBOSS_RESEND_API_KEY=
FINALBOSS_EMAIL_TO=you@example.com
FINALBOSS_EMAIL_FROM=Final Boss <onboarding@resend.dev>
FINALBOSS_PRIVACY_KEY=replace-with-a-long-random-value
FINALBOSS_HEALTHCHECK_URL=

# Optional: both adapters fail closed when their credentials are absent.
FINALBOSS_X_BEARER_TOKEN=
FINALBOSS_REDDIT_CLIENT_ID=
FINALBOSS_REDDIT_CLIENT_SECRET=

# Non-secret runtime overrides.
FINALBOSS_CONFIG_PATH=config/newsletter.yaml
FINALBOSS_SOURCES_PATH=config/sources.yaml
FINALBOSS_LOG_LEVEL=INFO
FINALBOSS_ENVIRONMENT=development
